{
  "name": "CEL Conecta",
  "short_name": "CEL Conecta",
  "description": "Conversas, mural e avisos da comunidade do Centro Educativo Líder – Visão do Futuro",
  "lang": "pt",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#10583C",
  "theme_color": "#0E2240",
  "icons": [
    {
      "src": "cel-icone-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "cel-icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "cel-icone-mascaravel-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "cel-icone.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./partilhar-recebido",
    "method": "POST",
    "enctype": "multipart/form-data",
