      "title": "titulo",
      "text": "texto",
      "url": "link",
      "files": [
        {
          "name": "ficheiros",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            "application/*",
            "text/*"
          ]
        }
      ]
    }
  }
